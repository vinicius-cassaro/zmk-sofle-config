#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include "eyelash_sofle-layouts.dtsi"

/ {

    chosen {
        zmk,kscan = &kscan0;
        zmk,battery = &vbatt;
        zmk,underglow = &led_strip;
        zmk,backlight = &backlight;
        zmk,physical-layout = &eyelash_sofle_layout;

    };

    status_leds: status_leds {
        compatible = "eyelash,status-leds";
        zero-led-index = <0>;
        one-led-index = <1>;
        two-led-index = <2>;
        three-led-index = <3>;
        four-led-index = <4>;
        five-led-index = <5>;
        six-led-index = <6>;
    };

    led_overlay: led_overlay {
        compatible = "eyelash,led-strip-overlay";
        target = <&led_strip>;
        chain-length = <7>;
    };

    backlight: pwmleds {
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
        };
    };

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <40>;
        status = "disabled";
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        triggers-per-rotation = <20>;
        sensors = <&left_encoder>;
    };

    kscan0: kscan {
        wakeup-source;
        diode-direction = "col2row";
    };

    ext-power {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
        init-delay-ms = <50>;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)  RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)  RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12)
        >;
    };
};

&pinctrl {

    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                <NRF_PSEL(SPIM_MISO, 0, 25)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                <NRF_PSEL(SPIM_MISO, 0, 25)>;
            low-power-enable;
        };
    };

    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 12)>; // WS2812_VEXT_DATA
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 12)>;
            low-power-enable;
        };
    };
    pwm0_default: pwm0_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 13)>;
        };
    };
    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 13)>;
            low-power-enable;
        };
    };
};

/*
 * Sofle ZMK - WS2812 RGB LED configuration
 *
 * Cada metade do teclado possui 29 LEDs WS2812.
 *
 * IMPORTANTE:
 * Este arquivo configura UMA metade do teclado por firmware.
 * Como o Sofle é split, o mesmo arquivo pode ser usado/configurado
 * para cada lado, desde que o SPI/pinos usados sejam os mesmos.
 *
 * O chain-length = <29> informa ao driver que existem 29 LEDs
 * endereçáveis individualmente na cadeia WS2812.
 *
 * Exemplo da cadeia física:
 *
 *   MCU -> LED 0 -> LED 1 -> LED 2 -> ... -> LED 27 -> LED 28
 *
 * Cada LED pode receber uma cor diferente. O índice lógico do LED
 * não precisa necessariamente corresponder à ordem visual das teclas;
 * isso depende de como os LEDs foram ligados fisicamente no PCB.
 */

&spi3 {
    /*
     * Usa o periférico SPI3 do nRF para gerar o sinal necessário
     * para os LEDs WS2812.
     */
    compatible = "nordic,nrf-spim";
    status = "okay";

    /*
     * Seleciona os pinos usados pelo SPI3.
     *
     * spi3_default = configuração normal dos pinos.
     * spi3_sleep   = configuração usada quando o periférico entra
     *                em estado de baixo consumo.
     */
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    /*
     * Define a cadeia de LEDs WS2812 conectada ao SPI3.
     */
    led_strip: ws2812@0 {
        /*
         * Driver do ZMK/Zephyr para WS2812 controlado através de SPI.
         */
        compatible = "worldsemi,ws2812-spi";

        status = "okay";

        /*
         * Necessário pelo binding de SPI.
         * Para este dispositivo, o valor não representa um LED específico.
         */
        reg = <0>;

        /*
         * Frequência usada pelo SPI para codificar os bits do protocolo
         * WS2812.
         */
        spi-max-frequency = <4000000>;

        /*
         * CADA METADE possui 29 LEDs.
         *
         * Portanto:
         *
         *   LED 0
         *   LED 1
         *   ...
         *   LED 28
         *
         * Total = 29 LEDs.
         *
         * Não coloque 58 aqui. O firmware de cada metade controla
         * sua própria cadeia de 29 LEDs.
         */
        chain-length = <7>;

        /*
         * Representação de um bit "1" do protocolo WS2812 através
         * de um frame SPI.
         */
        spi-one-frame = <0x70>;

        /*
         * Representação de um bit "0" do protocolo WS2812 através
         * de um frame SPI.
         */
        spi-zero-frame = <0x40>;

        /*
         * Define a ordem dos canais de cor do LED.
         *
         * Apesar de muitos LEDs serem chamados de RGB, o WS2812
         * normalmente recebe os dados na ordem GRB.
         *
         * Portanto:
         *   primeiro  -> Green
         *   segundo   -> Red
         *   terceiro  -> Blue
         */
        color-mapping =
            <LED_COLOR_ID_GREEN
             LED_COLOR_ID_RED
             LED_COLOR_ID_BLUE>;
    };
};


zephyr_udc0: &usbd {
    compatible = "nordic,nrf-usbd";
    status = "okay";
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

nice_view_spi: &spi0 {
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
};              